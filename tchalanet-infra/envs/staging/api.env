# envs/staging/api.env - API runtime overrides for staging (non-secrets)
SPRING_PROFILES_ACTIVE=staging,grafana-cloud
SPRING_FLYWAY_ENABLED=true
SPRING_JPA_HIBERNATE_DDL_AUTO=none
FIREBASE_CREDENTIALS_HOST_PATH=/opt/tchalanet-infra/server/secrets/firebase-admin.json
FIREBASE_CREDENTIALS_PATH=/run/secrets/firebase-admin.json
TCH_US_LOTTERY_ENABLED=true
# Utiliser Unleash Edge pour l’API (proxy public)
TCH_FLAGS_URL=https://flags.stg.tchalanet.com/proxy

TCH_IDENTITY_PROVIDER=firebase
FIREBASE_BOOTSTRAP_ENABLED=true
FIREBASE_BOOTSTRAP_AUTO_RUN_ON_STARTUP=true
TCH_SECURITY_USER_BOOTSTRAP_MODE=ADMIN_PREPROVISIONED
TCH_SECURITY_USER_BOOTSTRAP_UPDATE_LAST_LOGIN=false
APP_CORS_ALLOWED_ORIGINS=https://test.tchalanet.com,https://stg.tchalanet.com,https://api.stg.tchalanet.com,https://tchalanet-web-stg.pages.dev,https://*.tchalanet-web-stg.pages.dev,https://app.stg.tchalanet.com
APP_CORS_ALLOWED_HEADERS=Authorization,Content-Type,Accept,Origin,Idempotency-Key,X-Request-Id,X-Tenant-Id,X-Deleted-Visibility,X-Tch-Tenant-Override,X-Tch-Act-As,X-Tch-Act-As-Terminal,X-Tch-Override-Reason,X-Tch-Client-Type,X-Tch-Surface,X-Tch-Operational-Source,X-Tch-Terminal-Id,X-Tch-Outlet-Id,X-Tch-Sales-Session-Id
OTEL_TRACES_EXPORT_ENABLED=true
# Neon can make the Actuator DB health indicator slow in disposable staging.
# Keep Docker/API liveness responsive; functional DB failures still surface on
# authenticated API calls and Flyway/startup.
MANAGEMENT_HEALTH_DEFAULTS_ENABLED=false
MANAGEMENT_HEALTH_DB_ENABLED=false

# Staging shares state with a client-facing demo (test.tchalanet.com), so the
# automatic draw schedulers run like a real environment instead of requiring
# manual triggers from Ops.
TCH_DRAW_SCHEDULER_ACTIVE=true
TCH_DRAW_LIFECYCLE_ACTIVE=true
TCH_DRAW_SETTLEMENT_ACTIVE=true
TCH_DRAW_RESULTS_SCHEDULER_ACTIVE=true
