# Staging runtime config — NON-SECRET topology only.
# Credential secrets (POSTGRES_PASSWORD, APP_PASS, SPRING_DATASOURCE_PASSWORD, …)
# are generated and injected at deploy time from Doppler — see
# scripts/doppler/generate-secrets.sh and scripts/remote/deploy-runtime-services.sh.
# Never commit real passwords here; set them in Doppler and rotate if leaked.
POSTGRES_USER=admin
# Hosts (staging-specific)
API_HOST=api.stg.tchalanet.com
FLAGS_HOST=flags.stg.tchalanet.com
STATS_HOST=stats.stg.tchalanet.com
APP_WEB_ORIGIN=https://test.tchalanet.com,https://stg.tchalanet.com,https://api.stg.tchalanet.com
# Spring Boot (staging profile)
SPRING_PROFILES_ACTIVE=staging
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/tchalanet_db
SPRING_DATASOURCE_USERNAME=app_user


APP_DB=tchalanet_db
APP_USER=app
UN_DB=unleash

APP_WEB_HOST=app.staging.tchalanet.com


# API service URLs
TCH_REDIS_URL=redis://redis:6379
TCH_FLAGS_URL=http://unleash:4242/api
