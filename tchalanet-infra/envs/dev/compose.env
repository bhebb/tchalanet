# Compose-time variables (dev)
# Override/extend common compose.env for dev environment

# Docker networks (dev-specific)
DOCKER_NETWORK_EDGE=edge-dev
DOCKER_NETWORK_BACK=back-dev

# Environment
ENV=dev

# Optional: Override image tags for dev if different from common
IMAGE_TAG=local-dev

# Traefik dashboard en dev via port 8080
TRAEFIK_API_INSECURE=true

# API Spring profile for Docker dev.
# Docker dev is the local E2E runtime and intentionally uses Firebase Auth Emulator.
# Local IDE uses real Firebase by default through application-local-ide.yaml.
SPRING_PROFILES_ACTIVE=dev,insecure
TCH_IDENTITY_PROVIDER=firebase-emulator
FIREBASE_PROJECT_ID=demo-tchalanet-local
FIREBASE_AUTH_EMULATOR_HOST=firebase-emulator:9099
FIREBASE_BOOTSTRAP_ENABLED=true
FIREBASE_BOOTSTRAP_AUTO_RUN_ON_STARTUP=true
TCH_IDENTITY_FIREBASE_BOOTSTRAP_USERS=superadmin,admin
TCH_DRAW_RESULTS_LIMITS_HARD_DAYS_BACK=14
API_OTEL_SERVICE_NAME=tchalanet-api-dev
