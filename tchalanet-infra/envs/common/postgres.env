# envs/common/postgres.env - PostgreSQL container config (dev and staging)
# The container is a Compose-managed service; SPRING_DATASOURCE_URL and
# SPRING_DATASOURCE_USERNAME are committed in envs/<env>/.env, and only the
# password comes from Doppler → .secrets.

POSTGRES_USER=postgres
POSTGRES_DB=postgres
POSTGRES_INITDB_ARGS=--data-checksums
POSTGRES_HOST_AUTH_METHOD=scram-sha-256
POSTGRES_CONTAINER=tchl-postgres
POSTGRES_VOLUME=pgdata

APP_DB_NAME=tchalanet_db
APP_DB_USER=app_user
# APP_DB_PASSWORD → inject via envs/dev/.secrets
