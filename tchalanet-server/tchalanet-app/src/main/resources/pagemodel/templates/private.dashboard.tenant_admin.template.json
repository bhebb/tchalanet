{
  "code": "private.dashboard.tenant_admin",
  "logicalId": "private.dashboard.tenant_admin",
  "scope": "private",
  "slug": "dashboard",
  "name": "Tenant admin dashboard",
  "label": "Tenant admin dashboard",
  "schemaVersion": 2,
  "schema": {},
  "isDefault": true,
  "level": "GLOBAL",
  "tenantId": null,
  "description": "Tenant admin dashboard V1: KPIs, sales insights and quick actions (dynamic binding, seller_terminal model).",
  "model": {
    "meta": {
      "id": "private.dashboard.tenant_admin",
      "scope": "private",
      "slug": "dashboard",
      "context": "private_dashboard_tenant_admin",
      "schemaVersion": 2,
      "langs": ["fr", "en", "ht"],
      "defaultLang": "ht"
    },
    "theme": {
      "presetId": "tchalanet",
      "mode": "light",
      "density": 0
    },
    "shell": {
      "component": "PrivateShell",
      "binding": {
        "mode": "dynamic",
        "source": "jsonFile"
      },
      "props": {
        "fileKey": "private_shell_tenant_admin"
      }
    },
    "content": {
      "layout": {
        "component": "GridLayout",
        "rows": [
          {
            "id": "kpis",
            "labelKey": "layout.dashboard.tenant_admin.kpis",
            "columns": [
              {
                "span": 12,
                "widgets": ["dashboard.tenantAdmin.kpis"]
              }
            ]
          },
          {
            "id": "quickActions",
            "labelKey": "layout.dashboard.tenant_admin.quick_actions",
            "columns": [
              {
                "span": 12,
                "widgets": ["dashboard.tenantAdmin.quickActions"]
              }
            ]
          },
          {
            "id": "salesInsights",
            "labelKey": "layout.dashboard.tenant_admin.sales_insights",
            "columns": [
              {
                "span": 7,
                "widgets": ["dashboard.tenantAdmin.salesTrend"]
              },
              {
                "span": 5,
                "widgets": ["dashboard.tenantAdmin.gameBreakdown"]
              }
            ]
          },
          {
            "id": "commission",
            "labelKey": "layout.dashboard.tenant_admin.commission",
            "columns": [
              {
                "span": 12,
                "widgets": ["dashboard.tenantAdmin.commission"]
              }
            ]
          }
        ]
      },
      "widgets": {
        "dashboard.tenantAdmin.kpis": {
          "type": "KpiGridWidget",
          "binding": {
            "mode": "dynamic",
            "source": "tenant_admin_dashboard"
          },
          "props": {
            "titleKey": "dashboard.tenant_admin.kpis.title",
            "feedbackTargets": [
              "tenant_admin_dashboard.kpis",
              "tenant_admin_dashboard.live_sales",
              "tenant_admin_dashboard.open_draws"
            ],
            "items": [
              {
                "id": "salesToday",
                "labelKey": "admin.kpi.sales_today.label",
                "icon": "payments",
                "tone": "accent",
                "route": "/app/admin/reports/sales"
              },
              {
                "id": "ticketCountToday",
                "labelKey": "admin.kpi.tickets_sold.label",
                "icon": "confirmation_number",
                "tone": "neutral",
                "route": "/app/admin/tickets"
              },
              {
                "id": "activeSellerTerminals",
                "labelKey": "admin.kpi.active_seller_terminals.label",
                "icon": "point_of_sale",
                "tone": "success",
                "route": "/app/admin/seller-terminals?status=ACTIVE"
              },
              {
                "id": "openDraws",
                "labelKey": "admin.kpi.open_draws.label",
                "icon": "event_available",
                "tone": "primary",
                "route": "/app/admin/draws?status=OPEN"
              }
            ]
          }
        },
        "dashboard.tenantAdmin.salesTrend": {
          "type": "TrendChartWidget",
          "binding": {
            "mode": "dynamic",
            "source": "tenant_admin_dashboard"
          },
          "props": {
            "titleKey": "dashboard.tenant_admin.sales_trend.title",
            "emptyKey": "dashboard.tenant_admin.sales_trend.empty",
            "hideOnError": true,
            "feedbackTargets": ["tenant_admin_dashboard.analytics"],
            "points": { "source": "dynamic", "path": "points" },
            "labelPath": "label",
            "labelFormat": "date-short",
            "valuePath": "grossSales"
          }
        },
        "dashboard.tenantAdmin.gameBreakdown": {
          "type": "BreakdownListWidget",
          "binding": {
            "mode": "dynamic",
            "source": "tenant_admin_dashboard"
          },
          "props": {
            "titleKey": "dashboard.tenant_admin.game_breakdown.title",
            "emptyKey": "dashboard.tenant_admin.game_breakdown.empty",
            "hideOnError": true,
            "items": { "source": "dynamic", "path": "items" },
            "labelPath": "label",
            "valuePath": "grossSales",
            "valueFormat": "currency",
            "currencyCode": "HTG"
          }
        },
        "dashboard.tenantAdmin.commission": {
          "type": "CommissionSummaryWidget",
          "binding": {
            "mode": "dynamic",
            "source": "tenant_admin_dashboard"
          },
          "props": {
            "titleKey": "dashboard.tenant_admin.commission.title",
            "feedbackTargets": ["tenant_admin_dashboard.commission"],
            "manageLink": "/app/admin/controls/commission"
          }
        },
        "dashboard.tenantAdmin.quickActions": {
          "type": "QuickActionsWidget",
          "binding": {
            "mode": "dynamic",
            "source": "tenant_admin_dashboard"
          },
          "props": {
            "titleKey": "dashboard.tenant_admin.quick_actions.title",
            "actions": [
              {
                "id": "todaysDraws",
                "labelKey": "quickaction.admin.todays_draws",
                "icon": "event_available",
                "destination": { "kind": "route", "value": "/app/admin/draws?date=TODAY" }
              },
              {
                "id": "salesByTerminal",
                "labelKey": "quickaction.admin.sales_by_terminal",
                "icon": "point_of_sale",
                "destination": { "kind": "route", "value": "/app/admin/reports/sellers" }
              },
              {
                "id": "dailyReport",
                "labelKey": "quickaction.admin.daily_report",
                "icon": "today",
                "destination": { "kind": "route", "value": "/app/admin/reports/daily" }
              },
              {
                "id": "blockNumber",
                "labelKey": "quickaction.admin.block_number",
                "icon": "block",
                "destination": { "kind": "route", "value": "/app/admin/limits/number" }
              }
            ]
          }
        }
      }
    }
  }
}
