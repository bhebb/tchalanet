{
  "code": "private.dashboard.tenant_admin",
  "logicalId": "private.dashboard.tenant_admin",
  "scope": "private",
  "slug": "dashboard",
  "name": "Tenant admin dashboard",
  "label": "Tenant admin dashboard",
  "schemaVersion": 3,
  "schema": {},
  "isDefault": true,
  "level": "GLOBAL",
  "tenantId": null,
  "description": "Tenant admin operational dashboard: profitability KPIs, POS performance, sales trend and quick actions.",
  "model": {
    "meta": {
      "id": "private.dashboard.tenant_admin",
      "scope": "private",
      "slug": "dashboard",
      "context": "private_dashboard_tenant_admin",
      "schemaVersion": 3,
      "langs": ["fr", "en", "ht"],
      "defaultLang": "ht"
    },
    "theme": {
      "presetId": "tchalanet",
      "mode": "light",
      "density": 0
    },
    "shell": {
      "component": "PrivateShell",
      "binding": {
        "mode": "dynamic",
        "source": "jsonFile"
      },
      "props": {
        "fileKey": "private_shell_tenant_admin"
      }
    },
    "content": {
      "layout": {
        "component": "GridLayout",
        "rows": [
          {
            "id": "quickActions",
            "labelKey": "layout.dashboard.tenant_admin.quick_actions",
            "columns": [{ "span": 12, "widgets": ["dashboard.tenantAdmin.quickActions"] }]
          },
          {
            "id": "period",
            "labelKey": "layout.dashboard.tenant_admin.period",
            "columns": [{ "span": 12, "widgets": ["dashboard.tenantAdmin.periodSelector"] }]
          },
          {
            "id": "kpis",
            "labelKey": "layout.dashboard.tenant_admin.kpis",
            "columns": [{ "span": 12, "widgets": ["dashboard.tenantAdmin.kpis"] }]
          },
          {
            "id": "performance",
            "labelKey": "layout.dashboard.tenant_admin.performance",
            "columns": [{ "span": 12, "widgets": ["dashboard.tenantAdmin.terminalPerformance"] }]
          },
          {
            "id": "salesTrend",
            "labelKey": "layout.dashboard.tenant_admin.sales_trend",
            "columns": [{ "span": 12, "widgets": ["dashboard.tenantAdmin.salesTrend"] }]
          }
        ]
      },
      "widgets": {
        "dashboard.tenantAdmin.periodSelector": {
          "type": "PeriodSelectorWidget",
          "binding": { "mode": "dynamic", "source": "tenant_admin_dashboard" },
          "props": {
            "titleKey": "dashboard.tenant_admin.period.title",
            "options": ["TODAY", "YESTERDAY", "THIS_WEEK", "LAST_WEEK"]
          }
        },
        "dashboard.tenantAdmin.kpis": {
          "type": "KpiGridWidget",
          "binding": { "mode": "dynamic", "source": "tenant_admin_dashboard" },
          "props": {
            "titleKey": "dashboard.tenant_admin.kpis.title",
            "feedbackTargets": ["tenant_admin_dashboard.kpis"],
            "items": [
              {
                "id": "grossSales",
                "labelKey": "admin.kpi.gross_sales.label",
                "icon": "payments",
                "tone": "accent",
                "route": "/app/admin/reports/sales",
                "value": { "source": "dynamic", "path": "grossSales.value" },
                "currencyCode": "HTG"
              },
              {
                "id": "sellerCommissionPayable",
                "labelKey": "admin.kpi.seller_commission_payable.label",
                "icon": "payments",
                "tone": "warning",
                "value": { "source": "dynamic", "path": "sellerCommissionPayable.value" },
                "currencyCode": "HTG"
              },
              {
                "id": "estimatedNetRevenue",
                "labelKey": "admin.kpi.estimated_net_revenue.label",
                "icon": "account_balance",
                "tone": "primary",
                "value": { "source": "dynamic", "path": "estimatedNetRevenue.value" },
                "currencyCode": "HTG"
              },
              {
                "id": "availablePos",
                "labelKey": "admin.kpi.available_pos.label",
                "icon": "point_of_sale",
                "tone": "success",
                "route": "/app/admin/seller-terminals?status=ACTIVE",
                "value": { "source": "dynamic", "path": "availablePos.value" }
              }
            ]
          }
        },
        "dashboard.tenantAdmin.terminalPerformance": {
          "type": "TerminalPerformanceWidget",
          "binding": { "mode": "dynamic", "source": "tenant_admin_dashboard" },
          "props": {
            "titleKey": "dashboard.tenant_admin.terminal_performance.title",
            "emptyKey": "dashboard.tenant_admin.terminal_performance.empty",
            "feedbackTargets": ["tenant_admin_dashboard.performance"]
          }
        },
        "dashboard.tenantAdmin.salesTrend": {
          "type": "TrendChartWidget",
          "binding": { "mode": "dynamic", "source": "tenant_admin_dashboard" },
          "props": {
            "titleKey": "dashboard.tenant_admin.sales_trend.title",
            "emptyKey": "dashboard.tenant_admin.sales_trend.empty",
            "singlePointKey": "dashboard.tenant_admin.sales_trend.single",
            "chartType": "bar",
            "valueFormat": "currency",
            "currencyCode": "HTG",
            "hideOnError": false,
            "feedbackTargets": ["tenant_admin_dashboard.analytics"],
            "points": { "source": "dynamic", "path": "points" },
            "labelPath": "label",
            "labelFormat": "date-short",
            "valuePath": "grossSales"
          }
        },
        "dashboard.tenantAdmin.quickActions": {
          "type": "QuickActionsWidget",
          "props": {
            "titleKey": "dashboard.tenant_admin.quick_actions.title",
            "actions": [
              {
                "id": "todaysDraws",
                "labelKey": "quickaction.admin.todays_draws",
                "icon": "event_available",
                "destination": { "kind": "route", "value": "/app/admin/draws?date=TODAY" }
              },
              {
                "id": "dailyReport",
                "labelKey": "quickaction.admin.daily_report",
                "icon": "today",
                "destination": { "kind": "route", "value": "/app/admin/reports/daily" }
              },
              {
                "id": "sellerTerminals",
                "labelKey": "quickaction.admin.seller_terminals",
                "icon": "point_of_sale",
                "destination": { "kind": "route", "value": "/app/admin/seller-terminals" }
              },
              {
                "id": "createSellerTerminal",
                "labelKey": "quickaction.admin.seller_terminal_add",
                "icon": "person_add",
                "destination": { "kind": "route", "value": "/app/admin/seller-terminals/new" }
              },
              {
                "id": "salesByTerminal",
                "labelKey": "quickaction.admin.sales_by_terminal",
                "icon": "receipt_long",
                "destination": { "kind": "route", "value": "/app/admin/reports/sellers" }
              },
              {
                "id": "salesByDraw",
                "labelKey": "quickaction.admin.sales_by_draw",
                "icon": "analytics",
                "destination": { "kind": "route", "value": "/app/admin/reports/draws" }
              },
              {
                "id": "blockNumber",
                "labelKey": "quickaction.admin.block_number",
                "icon": "block",
                "destination": { "kind": "route", "value": "/app/admin/limits/number" }
              },
              {
                "id": "blockSeller",
                "labelKey": "quickaction.admin.block_seller",
                "icon": "phonelink_lock",
                "destination": { "kind": "route", "value": "/app/admin/seller-terminals" }
              },
              {
                "id": "resetSellerPin",
                "labelKey": "quickaction.admin.reset_seller_pin",
                "icon": "lock_reset",
                "destination": { "kind": "route", "value": "/app/admin/seller-terminals" }
              },
              {
                "id": "drawResults",
                "labelKey": "quickaction.admin.draw_results",
                "icon": "fact_check",
                "destination": { "kind": "route", "value": "/app/admin/draws/results" }
              }
            ]
          }
        }
      }
    }
  }
}
