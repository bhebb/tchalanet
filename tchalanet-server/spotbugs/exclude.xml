<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- Lombok-generated code (getters expose internal rep) -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>

    <!-- CQRS data carriers -->
    <Match>
        <Class name="~.*Command$"/>
    </Match>
    <Match>
        <Class name="~.*Query$"/>
    </Match>
    <Match>
        <Class name="~.*Result$"/>
    </Match>
    <Match>
        <Class name="~.*Event$"/>
    </Match>

    <!-- API models / DTOs -->
    <Match>
        <Package name="~.*\.api\.model.*"/>
    </Match>

    <!-- JPA entities (mutable by design) -->
    <Match>
        <Class name="~.*JpaEntity$"/>
    </Match>

    <!-- Spring config / bootstrap -->
    <Match>
        <Class name="~.*Configuration$"/>
    </Match>
    <Match>
        <Class name="~.*Config$"/>
    </Match>

    <!--
      These constructors intentionally fail fast on invalid wiring or duplicate registrations.
      They do not expose partially initialized instances because construction aborts before the
      object is published; keep the exception narrow to these known validation constructors.
    -->
    <Match>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
        <Class name="com.tchalanet.server.platform.accesscontrol.api.exception.PermissionsDeniedException"/>
    </Match>
    <Match>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
        <Class name="com.tchalanet.server.platform.accesscontrol.internal.exception.PermissionsDeniedException"/>
    </Match>
    <Match>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
        <Class name="com.tchalanet.server.platform.document.internal.service.DefaultDocumentApi"/>
    </Match>
    <Match>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
        <Class name="com.tchalanet.server.core.uslottery.internal.infra.external.ca.CaliforniaDrawResultsClient"/>
    </Match>
    <Match>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
        <Class name="com.tchalanet.server.core.uslottery.internal.infra.external.fl.FloridaDrawResultsClient"/>
    </Match>
    <Match>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
        <Class name="com.tchalanet.server.core.uslottery.internal.infra.external.ga.GeorgiaDrawResultsClient"/>
    </Match>
    <Match>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
        <Class name="com.tchalanet.server.core.uslottery.internal.infra.external.mi.MichiganDrawResultsClient"/>
    </Match>
    <Match>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
        <Class name="com.tchalanet.server.core.uslottery.internal.infra.external.nj.NewJerseyDrawResultsClient"/>
    </Match>
    <Match>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
        <Class name="com.tchalanet.server.core.uslottery.internal.infra.external.ny.NewYorkDrawResultsClient"/>
    </Match>
    <Match>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
        <Class name="com.tchalanet.server.core.uslottery.internal.infra.external.oh.OhioDrawResultsClient"/>
    </Match>
    <Match>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
        <Class name="com.tchalanet.server.core.uslottery.internal.infra.external.oh.auth.OhioAuthClient"/>
    </Match>
    <Match>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
        <Class name="com.tchalanet.server.app.config.cache.CombinedCache"/>
    </Match>
    <Match>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
        <Class name="com.tchalanet.server.app.job.registry.SpringTchJobRegistry"/>
    </Match>
</FindBugsFilter>
